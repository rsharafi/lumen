<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime is required for notarisation, and it will not load
       a library signed by anyone else - which for a PyInstaller bundle is
       every last .so and .dylib, all of them re-signed by us here, and the
       interpreter loading them by path at runtime rather than at link time.
       This is the one exception that makes that legal. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
